# Synthetic mode is the default and requires no external credentials.
NODE_ENV=development
LOG_LEVEL=info
API_VERSION=v1
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BLOCKCHAIR_API_KEY=
ETHERSCAN_API_KEY=
ETHERSCAN_CHAIN_ID=1
BITCOIN_ESPLORA_BASE_URL=
TRONGRID_API_KEY=
TRONGRID_BASE_URL=https://api.trongrid.io
CASHNET_PROVIDER_TIMEOUT_MS=10000
CASHNET_PROVIDER_MAX_RETRIES=2
KAFKA_BROKER_URL=
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
JWT_SECRET=
CASHNET_DATA_MODE=synthetic
# Development-only identity boundary for persistent /api/v1 routes. Never enable in production.
CASHNET_DEV_AUTH_ENABLED=false
# Optional approved, local, read-only address-label dataset. No data is enabled by default.
CASHNET_LABEL_DATASET_PATH=
CASHNET_LABEL_DATASET_APPROVED=false
CASHNET_LABEL_DATASET_NAME=
CASHNET_LABEL_DATASET_VERSION=
CASHNET_LABEL_DATASET_LICENSE=
